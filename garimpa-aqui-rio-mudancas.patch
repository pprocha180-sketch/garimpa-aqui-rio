diff --git a/src/routes/_authenticated/enviar-brecho.tsx b/src/routes/_authenticated/enviar-brecho.tsx
new file mode 100644
index 0000000..3523a3b
--- /dev/null
+++ b/src/routes/_authenticated/enviar-brecho.tsx
@@ -0,0 +1,154 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { useState } from "react";
+import { useMutation } from "@tanstack/react-query";
+import { Campo, FormShell, inputClasses } from "@/components/FormShell";
+import { bairros, categorias } from "@/data/brechos";
+import { enviarBrecho } from "@/lib/brechos.functions";
+
+export const Route = createFileRoute("/_authenticated/enviar-brecho")({
+  head: () => ({
+    meta: [
+      { title: "Enviar brechó — Garimpa Aqui" },
+      {
+        name: "description",
+        content: "Indique um brechó do Rio de Janeiro para entrar no catálogo do Garimpa Aqui.",
+      },
+      { property: "og:title", content: "Enviar brechó — Garimpa Aqui" },
+      { property: "og:description", content: "Indique um brechó do Rio para o catálogo." },
+    ],
+  }),
+  component: EnviarBrecho,
+});
+
+function EnviarBrecho() {
+  const [erro, setErro] = useState<string | null>(null);
+  const mutacao = useMutation({
+    mutationFn: (formData: FormData) =>
+      enviarBrecho({
+        data: {
+          nome: String(formData.get("nome-brecho") ?? ""),
+          bairro: String(formData.get("bairro-brecho") ?? ""),
+          categoria: String(formData.get("categoria-brecho") ?? ""),
+          endereco: String(formData.get("endereco-brecho") ?? ""),
+          instagram: String(formData.get("instagram-brecho") ?? ""),
+          whatsapp: String(formData.get("whatsapp-brecho") ?? ""),
+          descricao: String(formData.get("descricao-brecho") ?? ""),
+        },
+      }),
+    onError: (err: Error) =>
+      setErro(err.message || "Não foi possível enviar agora. Tente novamente."),
+  });
+
+  return (
+    <FormShell
+      titulo="Enviar brechó"
+      descricao="Indique um brechó do estado do Rio. A equipe revisa antes de publicar."
+      acao={mutacao.isPending ? "Enviando…" : "Enviar para revisão"}
+      enviando={mutacao.isPending}
+      onSubmit={(e) => {
+        e.preventDefault();
+        setErro(null);
+        mutacao.mutate(new FormData(e.currentTarget));
+      }}
+      rodape={
+        mutacao.isSuccess ? (
+          <p role="status" className="rounded-xl bg-mint px-4 py-2 font-semibold text-brand">
+            Recebemos sua indicação! Nossa equipe vai revisar antes de publicar no catálogo.
+          </p>
+        ) : erro ? (
+          <p role="alert" className="rounded-xl bg-red-100 px-4 py-2 font-semibold text-red-700">
+            {erro}
+          </p>
+        ) : null
+      }
+    >
+      <Campo id="nome-brecho" rotulo="Nome do brechó">
+        <input
+          id="nome-brecho"
+          name="nome-brecho"
+          type="text"
+          required
+          disabled={mutacao.isPending}
+          className={inputClasses}
+        />
+      </Campo>
+      <Campo id="bairro-brecho" rotulo="Bairro">
+        <select
+          id="bairro-brecho"
+          name="bairro-brecho"
+          required
+          disabled={mutacao.isPending}
+          className={inputClasses}
+          defaultValue=""
+        >
+          <option value="" disabled>
+            Escolha um bairro
+          </option>
+          {bairros.map((b) => (
+            <option key={b} value={b}>
+              {b}
+            </option>
+          ))}
+        </select>
+      </Campo>
+      <Campo id="categoria-brecho" rotulo="Categoria principal">
+        <select
+          id="categoria-brecho"
+          name="categoria-brecho"
+          required
+          disabled={mutacao.isPending}
+          className={inputClasses}
+          defaultValue=""
+        >
+          <option value="" disabled>
+            Escolha uma categoria
+          </option>
+          {categorias.map((c) => (
+            <option key={c.slug} value={c.nome}>
+              {c.nome}
+            </option>
+          ))}
+        </select>
+      </Campo>
+      <Campo id="endereco-brecho" rotulo="Endereço ou forma de atendimento">
+        <input
+          id="endereco-brecho"
+          name="endereco-brecho"
+          type="text"
+          required
+          disabled={mutacao.isPending}
+          className={inputClasses}
+        />
+      </Campo>
+      <Campo id="instagram-brecho" rotulo="Instagram">
+        <input
+          id="instagram-brecho"
+          name="instagram-brecho"
+          type="text"
+          placeholder="@brecho"
+          disabled={mutacao.isPending}
+          className={inputClasses}
+        />
+      </Campo>
+      <Campo id="whatsapp-brecho" rotulo="WhatsApp">
+        <input
+          id="whatsapp-brecho"
+          name="whatsapp-brecho"
+          type="tel"
+          placeholder="(21) 99999-0000"
+          disabled={mutacao.isPending}
+          className={inputClasses}
+        />
+      </Campo>
+      <Campo id="descricao-brecho" rotulo="Descrição">
+        <textarea
+          id="descricao-brecho"
+          name="descricao-brecho"
+          rows={4}
+          disabled={mutacao.isPending}
+          className={inputClasses}
+        />
+      </Campo>
+    </FormShell>
+  );
+}
