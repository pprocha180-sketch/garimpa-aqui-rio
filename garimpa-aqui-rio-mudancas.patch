@@ -0,0 +1,7 @@
+-- Permite que usuários autenticados enviem novos brechós (ficam como "pending" até aprovação)
+GRANT INSERT ON public.brechos TO authenticated;
+
+CREATE POLICY "Usuario autenticado envia brecho"
+ON public.brechos FOR INSERT
+TO authenticated
+WITH CHECK (status = 'pending');
